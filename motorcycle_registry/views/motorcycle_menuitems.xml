<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="motorcycle_list_action" model="ir.actions.act_window">
        <field name="name">Motorcycle List</field>
        <field name="res_model">motorcycle.registry</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first motorcycle</p>
        </field>
    </record>

    <menuitem name="Motorcycle Registry" id="menu_motorcycle" sequence="1">
        <menuitem id="menu_motorcycle_sub" name="Motorcycle Settings" sequence="1">
            <menuitem id="menu_motorcycle_registry" name="Motorcycles" sequence="2" action="motorcycle_list_action"/>
        </menuitem>
    </menuitem>

</odoo>